<?xml version="1.0"?>

<project name="setup_checker" default="check_setup">
	<description>
                description: "Checks the setup for installing ES"
		author: "es-make Project Team, ETH Zurich"
        </description>

	<!--
		============
		== README ==
		============
		
		This script (and those who get called by it) works currently only on UNIX, 
		and is under heavy developement.
		
		USE ON YOUR OWN RISK!
		
		start the script like this:
			cd %EIFFEL_SRC%
			geant -b check_setup.eant
	-->

	<target name="help">
		<description>
			Display help message
		</description>
                <echo message="Usage: geant check_setup" />
        </target>

	<target name="check_setup" depend="check_setup_unix,check_setup_win">
		<description>
			Check setup
		</description>
	</target>
	<target name="check_setup_unix" unless="$is_windows">
		<echo message="Checking environment variables..." />
		<echo message="  -> EIFFEL_SVN: ${EIFFEL_SVN}, ok" if="${EIFFEL_SVN}" />
		<echo message="  -> EIFFEL_SVN: not set, ! please check !" unless="${EIFFEL_SVN}" />
		<echo message="  -> EIFFEL_SRC: ${EIFFEL_SRC}, ok" if="${EIFFEL_SRC}" />
		<echo message="  -> EIFFEL_SRC: not set, ! please check !" unless="${EIFFEL_SRC}" />
		<echo message="  -> ISE_PLATFORM: ${ISE_PLATFORM}, ok" if="${ISE_PLATFORM}" />
		<echo message="  -> ISE_PLATFORM: not set, ! please check !" unless="${ISE_PLATFORM}" />
		<echo message="  -> ISE_LIBRARY: ${ISE_LIBRARY}, ok" if="${ISE_LIBRARY}" />
		<echo message="  -> ISE_LIBRARY: not set, ! please check !" unless="${ISE_LIBRARY}" />
		<echo message="  -> ISE_EIFFEL: ${ISE_EIFFEL}, ok" if="${ISE_EIFFEL}" />
		<echo message="  -> ISE_EIFFEL: not set, ! please check !" unless="${ISE_EIFFEL}" />
		
		<echo message="Checking resources..." />
		<available resource="$EIFFEL_SVN" variable="conf_eiffel_svn" if="${EIFFEL_SVN}" />
		<available resource="$EIFFEL_SRC" variable="conf_eiffel_src" if="${EIFFEL_SRC}" />
		<available resource="$ISE_LIBRARY" variable="conf_ise_library" if="${ISE_LIBRARY}" />
		<available resource="$ISE_EIFFEL" variable="conf_ise_eiffel" if="${ISE_EIFFEL}" />
		<echo message="  -> $EIFFEL_SVN: ok" if="${conf_eiffel_svn}" />
		<echo message="  -> EIFFEL_SVN not set, can't figure out resource: ! please check !" unless="${conf_eiffel_svn}" />
		<echo message="  -> $EIFFEL_SRC: ok" if="${conf_eiffel_src}" />
		<echo message="  -> EIFFEL_SRC not set, can't figure out resource: ! please check !" unless="${conf_eiffel_src}" />
		<echo message="  -> $ISE_LIBRARY: ok" if="${conf_ise_library}" />
		<echo message="  -> ISE_LIBRARY not set, can't figure out resource: ! please check !" unless="${conf_ise_library}" />
		<echo message="  -> $ISE_EIFFEL: ok" if="${conf_ise_eiffel}" />
		<echo message="  -> ISE_EIFFEL not set, can't figure out resource: ! please check !" unless="${conf_ise_eiffel}" />
		<exec executable="which ec > /dev/null" exit_code_variable="conf_ec" />
		<echo message="  -> ec in path, exit code: ${conf_ec}, ok" if="${conf_ec}=0" />
		<echo message="  -> ec not in path, exit code: ${conf_ec}, ! please check !" unless="${conf_ec}=0" />
		<exec executable="ec -version | grep -q 'version 5.7' > /dev/null" exit_code_variable="conf_ec_version" />
		<echo message="  -> ec version 5.7, exit code: ${conf_ec_version}, ok" if="${conf_ec_version}=0" />
		<echo message="  -> ec wrong version, exit code: ${conf_ec_version}, ! please check !" unless="${conf_ec_version}=0" />

		<echo message="Checking tools..." />
		<exec executable="which which > /dev/null 2> /dev/null" exit_code_variable="conf_which" />
		<echo message="  -> which found, exit code: ${conf_which}, ok" if="${conf_which}=0" />
		<echo message="  -> which not in path, exit code: ${conf_which}, ! please check !" unless="${conf_which}=0" />
		<exec executable="which pkg-config > /dev/null" exit_code_variable="conf_pkgconfig" />
		<echo message="  -> pkg-config found, exit code: ${conf_pkgconfig}, ok" if="${conf_pkgconfig}=0" />
		<echo message="  -> pkg-config not in path, exit code: ${conf_pkgconfig}, ! please check !" unless="${conf_pkgconfig}=0" />

		<echo message="Checking dependencies..." />
		<exec executable="which gcc > /dev/null" exit_code_variable="conf_gcc" />
		<echo message="  -> gcc found, exit code: ${conf_gcc}, ok" if="${conf_gcc}=0" />
		<echo message="  -> gcc not in path, exit code: ${conf_gcc}, ! please check !" unless="${conf_gcc}=0" />
		<exec executable="pkg-config --exists gtk+-2.0" exit_code_variable="conf_pkgconfig_gtk" />
		<echo message="  -> gtk 2.0 found, exit code: ${conf_pkgconfig_gtk}, ok" if="${conf_pkgconfig_gtk}=0" />
		<echo message="  -> gtk 2.0 not in pkgconfig path, exit code: ${conf_pkgconfig_gtk}, ! please check !" unless="${conf_pkgconfig_gtk}=0" />

		<echo message="Setup check complete. Please verify configuration!" />
	</target>
	<target name="check_setup_win" if="$is_windows">
		<echo message="This script doesn't run on windows, yet." />
	</target>
</project>
