				<exclude>/CVS$</exclude>
				<exclude>cdd_tests</exclude>
			</file_rule>
			<cluster name="root_cluster_tests" location="\home\aleitner\src\cdd_trunk\tests\cdd\false_precondition_001\cdd_tests\">
				<cluster name="root_cluster_tests_tests" location="\home\aleitner\src\cdd_trunk\tests\cdd\false_precondition_001\cdd_tests\cdd_tests\"/>
			</cluster>
		</cluster>
