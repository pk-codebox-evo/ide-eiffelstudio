<?xml version="1.0" encoding="ISO-8859-1"?><system xmlns="http://www.eiffel.com/developers/xml/configuration-1-0-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-0-0 http://www.eiffel.com/developers/xml/configuration-1-0-0.xsd" name="test_system" uuid="CC3058D3-4827-4CFA-87AA-A5790CE1C63A">
	<target name="test_system">
		<root cluster="root_cluster" class="ROOT_CLASS" feature="make"/>
		<option warning="true">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="false"/>
		</option>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="cdd" location="$EIFFEL_SRC\library\cdd\cdd.ecf"/>
		<cluster name="cdd_tests" location="$EIFFEL_SRC\examples\cdd\cdd_testing\tests"/>
		<cluster name="root_cluster" location="$EIFFEL_SRC\examples\cdd"/>
	</target>
	<target name="cdd_tester" extends="test_system">
		<description>Target for running cdd tests</description>
		<cluster name="cdd_tester" location="$EIFFEL_SRC\examples\cdd\cdd_testing"/>
		<root class="CDD_INTERPRETER" feature="make"/>
	</target>
</system>
