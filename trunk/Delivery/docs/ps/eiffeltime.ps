 /FmPD/pdfmark FmLD
 currentdistillerparams /CoreDistVersion get 2000 ge {
  /FmPD2/pdfmark FmLD
  /FmPA { mark exch /Dest exch 5 3 roll 
	/View [ /XYZ null 6 -2 roll FmDC exch pop null] /DEST FmPD 
  }FmBD
 } if
} if
